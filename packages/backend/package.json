{
  "name": "@omnisync/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OmniSync sync server: stores ciphertext only. Hono + Postgres (PGlite for zero-setup dev).",
  "exports": { ".": "./src/app.ts", "./db": "./src/db.ts" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@hono/node-server": "^2.1.5",
    "@omnisync/protocol": "workspace:*",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@omnisync/crypto": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0"
  }
}

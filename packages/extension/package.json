{
  "name": "@omnisync/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OmniSync browser extension: one WXT codebase built for Brave (Chromium MV3) and Zen (Firefox MV3).",
  "scripts": {
    "dev:brave": "wxt -b chrome",
    "dev:zen": "wxt -b firefox --mv3",
    "build": "pnpm build:brave && pnpm build:zen",
    "build:brave": "wxt build -b chrome",
    "build:zen": "wxt build -b firefox --mv3",
    "zip": "wxt zip -b chrome && wxt zip -b firefox --mv3",
    "postinstall": "wxt prepare",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "wxt build -b chrome && tsx e2e/two-profiles.ts && tsx e2e/passwords.ts"
  },
  "dependencies": {
    "@omnisync/crypto": "workspace:*",
    "@omnisync/protocol": "workspace:*"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@omnisync/backend": "workspace:*",
    "@types/node": "^22.0.0",
    "playwright-core": "1.56.1",
    "tsx": "^4.20.0",
    "wxt": "^0.21.4"
  }
}

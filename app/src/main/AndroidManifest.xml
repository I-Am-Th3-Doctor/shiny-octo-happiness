<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Uninstall shortcut in the long-press menu. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Contact search (asked at runtime, optional). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Search ALL files in shared storage (granted by you in Android settings, optional).
         Fine for a sideloaded app; Play would require a justification. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Android 10-12: storage read for music/photos (and files on 10, which has no All Files Access). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 13+: music and photos & videos search (each optional, asked from the permissions hub). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Message search (read-only, optional). -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Weather. The ONLY network traffic: Open-Meteo forecast + place search. No analytics. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Battery & Signals card. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Quick Actions: Do Not Disturb toggle and brightness (both granted by you in Settings). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Automatic favorites: launch counts from usage stats (granted by you in Settings, optional).
         Read on the device only, never sent anywhere. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ package visibility: let us see every launchable app. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Widget picker: see every app that provides home-screen widgets. -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
        <!-- "Default music player" picker: find installed media apps from what they declare. -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
    </queries>

    <application
        android:name=".SearchlightApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Searchlight">

        <!--
          The home screen. singleTask + HOME category = the launcher.
          configChanges keeps the activity alive across fold/unfold so the query,
          keyboard and scroll position survive; the layout adapts in code.
        -->
        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize|stateAlwaysVisible">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.Searchlight.Settings"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".WidgetCenterActivity"
            android:exported="false"
            android:label="@string/widget_center"
            android:theme="@style/Theme.Searchlight.Settings" />

        <activity
            android:name=".widgets.WidgetPickerActivity"
            android:exported="false"
            android:label="@string/widget_picker_title"
            android:theme="@style/Theme.Searchlight.Settings" />

        <!-- An app's "Add widget to home screen" (requestPinAppWidget) comes here. -->
        <activity
            android:name=".widgets.PinWidgetActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Searchlight.Translucent">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
            </intent-filter>
        </activity>

        <!-- After a backup restore, maps our old widget ids to the new ones. -->
        <!-- Home gestures: notification shade, quick settings, lock screen (turned on by you in
             Accessibility settings; reads nothing on screen). -->
        <service
            android:name=".gestures.GestureService"
            android:exported="true"
            android:label="@string/gesture_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/gesture_service" />
        </service>

        <receiver
            android:name=".widgets.WidgetRestoreReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_HOST_RESTORED" />
            </intent-filter>
        </receiver>

        <!-- Lets the Music card see media sessions. It ignores notifications entirely. -->
        <service
            android:name=".media.MediaListenerService"
            android:exported="true"
            android:label="@string/media_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

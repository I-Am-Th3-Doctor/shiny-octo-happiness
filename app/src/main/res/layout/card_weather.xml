<?xml version="1.0" encoding="utf-8"?>
<!-- One-row strip: icon, temperature, condition, high/low. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_m">

        <TextView
            android:id="@+id/weatherEmoji"
            style="@style/StripText"
            android:textAppearance="@style/TextAppearance.Searchlight.TileTitle" />

        <TextView
            android:id="@+id/weatherTemp"
            style="@style/StripText"
            android:layout_marginStart="@dimen/space_s"
            android:textAppearance="@style/TextAppearance.Searchlight.TileTitle" />

        <TextView
            android:id="@+id/weatherCondition"
            style="@style/StripText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_s"
            android:textAppearance="@style/TextAppearance.Searchlight.Body" />

        <TextView
            android:id="@+id/weatherHiLo"
            style="@style/StripText"
            android:layout_marginStart="@dimen/space_s"
            android:textColor="@color/on_surface_dim"
            android:textAppearance="@style/TextAppearance.Searchlight.Caption" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- One-row strip: battery %, charging status, then Wi-Fi and mobile signal (a long name
     loses its start, never the bars). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_m">

        <TextView
            android:id="@+id/batteryPercent"
            style="@style/StripText"
            android:textAppearance="@style/TextAppearance.Searchlight.TileTitle" />

        <TextView
            android:id="@+id/batteryStatus"
            style="@style/StripText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_s"
            android:textAppearance="@style/TextAppearance.Searchlight.Body" />

        <TextView
            android:id="@+id/wifiSignal"
            style="@style/StripText"
            android:layout_marginStart="@dimen/space_s"
            android:ellipsize="start"
            android:maxWidth="@dimen/size_strip_label_max"
            android:textColor="@color/on_surface_dim"
            android:textAppearance="@style/TextAppearance.Searchlight.Caption" />

        <TextView
            android:id="@+id/cellSignal"
            style="@style/StripText"
            android:layout_marginStart="@dimen/space_s"
            android:ellipsize="start"
            android:maxWidth="@dimen/size_strip_label_max"
            android:textColor="@color/on_surface_dim"
            android:textAppearance="@style/TextAppearance.Searchlight.Caption" />
    </LinearLayout>
</FrameLayout>

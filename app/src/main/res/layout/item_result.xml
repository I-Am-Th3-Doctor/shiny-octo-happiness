<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_result"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/size_row"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_m"
    android:paddingVertical="@dimen/space_xs">

    <FrameLayout
        android:layout_width="@dimen/size_avatar"
        android:layout_height="@dimen/size_avatar">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <!-- Initial / file-type / "=" badge, tinted per row. -->
        <TextView
            android:id="@+id/badge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/on_surface"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/OnWallpaperText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Searchlight.Body" />

        <TextView
            android:id="@+id/subtitle"
            style="@style/OnWallpaperText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/on_surface_dim"
            android:textAppearance="@style/TextAppearance.Searchlight.Caption"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/action1"
        android:layout_width="@dimen/size_touch"
        android:layout_height="@dimen/size_touch"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/action2"
        android:layout_width="@dimen/size_touch"
        android:layout_height="@dimen/size_touch"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:visibility="gone" />
</LinearLayout>

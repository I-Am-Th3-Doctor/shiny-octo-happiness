<?xml version="1.0" encoding="utf-8"?>
<!-- One-row strip: time, then the date (scrolls if it does not fit). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_m">

        <TextClock
            style="@style/StripText"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textAppearance="@style/TextAppearance.Searchlight.TileTitle" />

        <TextClock
            style="@style/StripText"
            android:layout_marginStart="@dimen/space_xs"
            android:format12Hour="a"
            android:format24Hour=""
            android:textColor="@color/on_surface_dim"
            android:textAppearance="@style/TextAppearance.Searchlight.Caption" />

        <!-- The date scrolls if it doesn't fit, so it's set by the card, not a TextClock. -->
        <io.github.iamth3doctor.searchlight.ui.MarqueeTextView
            android:id="@+id/calendarDate"
            style="@style/StripText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_m"
            android:textAppearance="@style/TextAppearance.Searchlight.Body" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Searchlight.Glance" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginBottom="@dimen/space_s"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="@color/on_surface_dim"
                android:textAppearance="@style/TextAppearance.Searchlight.TileTitle" />
        </LinearLayout>

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, MMMM d"
            android:format24Hour="EEEE, MMMM d"
            android:textColor="@color/on_surface"
            android:textAppearance="@style/TextAppearance.Searchlight.TileTitle" />

        <ProgressBar
            android:id="@+id/yearProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_progress"
            android:layout_marginTop="@dimen/space_s"
            android:progressBackgroundTint="@color/control_off"
            android:progressTint="@color/accent" />

        <TextView
            android:id="@+id/yearProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/on_surface_dim"
            android:textAppearance="@style/TextAppearance.Searchlight.Caption" />
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Searcho-style home: wallpaper, then near the bottom ONE frosted home card holding the tile
  pager (with page dots) and the search row. No dock, no app bar. While typing, the tiles fold
  away and results appear above the card.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <io.github.iamth3doctor.searchlight.ui.MaxWidthLinearLayout
        android:id="@+id/column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        app:maxWidth="@dimen/content_max_width">

        <!--
          The space above the home card. Idle: the widget grid (long-press to arrange). Searching:
          results, best one nearest the card. The home card is outside this area, so widgets can
          never end up underneath it.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <io.github.iamth3doctor.searchlight.widgets.WidgetGridView
                android:id="@+id/widgetGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="6dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/results"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:visibility="gone" />

            <!-- Edit mode only: add a widget, open settings, or finish arranging. -->
            <LinearLayout
                android:id="@+id/editBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_glance_card"
                android:elevation="6dp"
                android:orientation="horizontal"
                android:padding="4dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/editAdd"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_add_widget"
                    android:textColor="@color/on_wallpaper" />

                <Button
                    android:id="@+id/editSettings"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_launcher_settings"
                    android:textColor="@color/on_wallpaper" />

                <Button
                    android:id="@+id/editDone"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_done"
                    android:textColor="#FF8C9EFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!--
          The home card: one frosted panel. Top: swipeable tiles with their page dots (hidden
          while searching, or when every tile is off). Bottom: the search row, always there.
        -->
        <LinearLayout
            android:id="@+id/homeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:animateLayoutChanges="true"
            android:background="@drawable/bg_glance_card"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/cardArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/cards"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/card_height" />

                <LinearLayout
                    android:id="@+id/dots"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/searchPill"
                android:layout_width="match_parent"
                android:layout_height="@dimen/search_bar_height"
                android:background="@drawable/bg_search_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <ImageButton
                    android:id="@+id/searchIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_icon_desc"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:imeOptions="actionGo|flagNoExtractUi|flagNoPersonalizedLearning"
                    android:importantForAutofill="no"
                    android:inputType="text|textNoSuggestions|textFilter"
                    android:maxLines="1"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/on_wallpaper"
                    android:textColorHint="@color/on_wallpaper_dim"
                    android:textSize="18sp" />

                <!-- Calculator answer, right in the bar. -->
                <TextView
                    android:id="@+id/calcPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:maxLines="1"
                    android:textColor="#FF8C9EFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/clearButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/clear_desc"
                    android:src="@drawable/ic_close"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/settingsButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings_title"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>
        </LinearLayout>
    </io.github.iamth3doctor.searchlight.ui.MaxWidthLinearLayout>
</FrameLayout>

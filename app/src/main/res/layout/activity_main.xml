<?xml version="1.0" encoding="utf-8"?>
<!--
  Searcho-style home: wallpaper, then near the bottom ONE frosted home card holding the tile
  pager (with page dots) and the search row. No dock, no app bar. While typing, the tiles fold
  away and results appear above the card.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <io.github.iamth3doctor.searchlight.ui.MaxWidthLinearLayout
        android:id="@+id/column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        app:maxWidth="@dimen/content_max_width">

        <!--
          The space above the home card. Idle: the widget grid (long-press to arrange). Searching:
          results, best one nearest the card. The home card is outside this area, so widgets can
          never end up underneath it.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Top margin = the edit pill's lane, kept in both modes so widgets never shift
                 and the pill never covers the first row of cells. -->
            <io.github.iamth3doctor.searchlight.widgets.WidgetGridView
                android:id="@+id/widgetGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/space_s"
                android:layout_marginTop="@dimen/size_edit_bar_reserve" />

            <!--
              Searching: a stack above the card. A frosted results panel (apps grid, then
              sections; as tall as its results up to 70% of the screen, then it scrolls), and
              under it the web-search pill. Nothing sits directly on the wallpaper.
            -->
            <LinearLayout
                android:id="@+id/resultsStack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/inset_home_card"
                android:paddingBottom="@dimen/space_s"
                android:visibility="gone">

                <io.github.iamth3doctor.searchlight.ui.ResultsPanel
                    android:id="@+id/resultsPanel"
                    android:elevation="@dimen/elevation_raised"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="@dimen/space_s"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/results"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:padding="@dimen/space_m"
                        android:scrollbars="none" />
                </io.github.iamth3doctor.searchlight.ui.ResultsPanel>

                <LinearLayout
                    android:id="@+id/webPill"
                    android:elevation="@dimen/elevation_raised"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_row"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_m">

                    <ImageView
                        android:layout_width="@dimen/size_icon"
                        android:layout_height="@dimen/size_icon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        android:tint="@color/on_surface_dim" />

                    <TextView
                        android:id="@+id/webPillText"
                        style="@style/StripText"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_m"
                        android:textAppearance="@style/TextAppearance.Searchlight.Body" />
                </LinearLayout>
            </LinearLayout>

            <!-- Edit mode only: a slim floating pill, top-center, in the lane above the grid. -->
            <LinearLayout
                android:id="@+id/editBar"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_edit_bar"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_pill_raised"
                android:elevation="@dimen/elevation_raised"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_xs"
                android:visibility="gone">

                <TextView
                    android:id="@+id/editAdd"
                    style="@style/EditPillButton"
                    android:text="@string/edit_add_widget" />

                <ImageButton
                    android:id="@+id/editSettings"
                    android:layout_width="@dimen/size_edit_bar"
                    android:layout_height="@dimen/size_edit_bar"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu_launcher_settings"
                    android:padding="@dimen/space_s"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings" />

                <TextView
                    android:id="@+id/editDone"
                    style="@style/EditPillButton"
                    android:text="@string/edit_done"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!--
          The home card: one frosted panel, two rows tall. Top row: swipeable tiles with their
          page dots (hidden while searching, or when every tile is off). Bottom row: the search
          row, always there.
          No animateLayoutChanges: animating the search row up when the tiles hide shrinks it
          to zero height for a frame, and Android takes focus away from zero-size views, so the
          field lost focus and Backspace (a key event) went elsewhere.
        -->
        <LinearLayout
            android:id="@+id/homeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/inset_home_card"
            android:layout_marginBottom="@dimen/inset_home_card"
            android:elevation="@dimen/elevation_raised"
            android:orientation="vertical"
            android:padding="@dimen/space_s">

            <!-- One row of tiles (size_tile_height); the page dots sit inside
                 it along the bottom edge. -->
            <FrameLayout
                android:id="@+id/cardArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/cards"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_tile_height" />

                <LinearLayout
                    android:id="@+id/dots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:orientation="horizontal" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/searchPill"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_search_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_xs">

                <ImageButton
                    android:id="@+id/searchIcon"
                    android:layout_width="@dimen/size_touch"
                    android:layout_height="@dimen/size_touch"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search_icon_desc"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:imeOptions="actionGo|flagNoExtractUi|flagNoPersonalizedLearning"
                    android:importantForAutofill="no"
                    android:inputType="text|textNoSuggestions|textFilter"
                    android:maxLines="1"
                    android:paddingHorizontal="@dimen/space_xs"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/on_surface_dim"
                    android:textAppearance="@style/TextAppearance.Searchlight.TileTitle" />

                <!-- Calculator answer, right in the bar. -->
                <TextView
                    android:id="@+id/calcPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_xs"
                    android:ellipsize="start"
                    android:maxLines="1"
                    android:maxWidth="@dimen/size_calc_preview_max"
                    android:textAppearance="@style/TextAppearance.Searchlight.TileTitle"
                    android:textColor="@color/on_surface"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/clearButton"
                    android:layout_width="@dimen/size_touch"
                    android:layout_height="@dimen/size_touch"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/clear_desc"
                    android:src="@drawable/ic_close"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/settingsButton"
                    android:layout_width="@dimen/size_touch"
                    android:layout_height="@dimen/size_touch"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/settings_title"
                    android:src="@drawable/ic_settings" />
            </LinearLayout>
        </LinearLayout>
    </io.github.iamth3doctor.searchlight.ui.MaxWidthLinearLayout>

    <!--
      The app table: every app, A–Z, straight over the wallpaper (no background; the home card
      and widgets fade out while it's open). Opened by swiping up on empty home space; closed by
      swiping down (from the top of the list) or Back.
    -->
    <FrameLayout
        android:id="@+id/appTable"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appTableList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_m"
            android:scrollbars="none" />
    </FrameLayout>
</FrameLayout>

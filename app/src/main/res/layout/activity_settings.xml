<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <io.github.iamth3doctor.searchlight.ui.MaxWidthLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingBottom="@dimen/space_l"
        app:maxWidth="@dimen/content_max_width">

        <TextView style="@style/PageTitle" android:text="@string/settings_title" />

        <TextView style="@style/SettingsSection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="@dimen/space_xs" android:text="@string/settings_section_home" />

        <LinearLayout
            android:id="@+id/widgetCenterRow"
            style="@style/SettingsRow">
            <TextView style="@style/SettingsRowTitle" android:text="@string/widget_center" />
            <TextView style="@style/SettingsRowSummary" android:text="@string/widget_center_summary" />
        </LinearLayout>

        <!-- Music Player + Quick Actions settings, built from data in SettingsActivity. -->
        <LinearLayout
            android:id="@+id/tileSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/setDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_set_default"
            android:textAppearance="@style/TextAppearance.Searchlight.Body" />

        <Switch
            android:id="@+id/autoKeyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/size_touch"
            android:text="@string/settings_auto_keyboard"
            android:textAppearance="@style/TextAppearance.Searchlight.Body" />

        <LinearLayout
            android:id="@+id/greetingRow"
            style="@style/SettingsRow">
            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_greeting" />
            <TextView android:id="@+id/greetingValue" style="@style/SettingsRowSummary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/webEngineRow"
            style="@style/SettingsRow">
            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_web_engine" />
            <TextView android:id="@+id/webEngineValue" style="@style/SettingsRowSummary" />
        </LinearLayout>

        <TextView style="@style/SettingsSection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_section_gestures" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_gestures_help"
            android:textAppearance="@style/TextAppearance.Searchlight.Caption"
            android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout
            android:id="@+id/gesturesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView style="@style/SettingsSection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_section_permissions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_permissions_help"
            android:textAppearance="@style/TextAppearance.Searchlight.Caption"
            android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout
            android:id="@+id/permissionsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/indexStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Searchlight.Caption"
            android:textColor="?android:attr/textColorSecondary"
            android:textStyle="italic" />

        <Button
            android:id="@+id/reindex"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/index_rebuild"
            android:textAppearance="@style/TextAppearance.Searchlight.Body" />

        <TextView style="@style/SettingsSection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_section_favorites" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/favoritesHelp"
            android:text="@string/settings_favorites_help"
            android:textAppearance="@style/TextAppearance.Searchlight.Caption"
            android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout
            android:id="@+id/favoritesModeRow"
            style="@style/SettingsRow">
            <TextView style="@style/SettingsRowTitle" android:text="@string/settings_favorites_mode" />
            <TextView android:id="@+id/favoritesModeValue" style="@style/SettingsRowSummary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/usageAccessRow"
            style="@style/SettingsRow">
            <TextView style="@style/SettingsRowTitle" android:text="@string/usage_access_needed" />
            <TextView style="@style/SettingsRowSummary" android:text="@string/usage_access_needed_desc" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/favoritesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:orientation="vertical" />

        <TextView style="@style/SettingsSection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_section_about" />

        <TextView
            android:id="@+id/about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Searchlight.Caption"
            android:textColor="?android:attr/textColorSecondary" />
    </io.github.iamth3doctor.searchlight.ui.MaxWidthLinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview of the built-in Weather widget: plain, on the frosted glass of the
     Calendar widget. The place, small; the temperature, large, with a small condition icon; the
     condition in words; the high and low in gold. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="@dimen/size_preview_width" android:height="@dimen/size_preview_height"
    android:viewportWidth="120" android:viewportHeight="88">
    <!-- glass, with its hairline -->
    <path android:fillColor="#800B0B0D" android:strokeColor="#26FFFFFF" android:strokeWidth="0.8"
        android:pathData="M28,4h64a8,8 0,0 1,8 8v64a8,8 0,0 1,-8 8h-64a8,8 0,0 1,-8 -8v-64a8,8 0,0 1,8 -8z" />
    <!-- place -->
    <path android:fillColor="#B3FFFFFF" android:pathData="M29,12h22a1.6,1.6 0,0 1,0 3.2h-22a1.6,1.6 0,0 1,0 -3.2z" />
    <!-- temperature -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M31,38h24a3,3 0,0 1,3 3v10a3,3 0,0 1,-3 3h-24a3,3 0,0 1,-3 -3v-10a3,3 0,0 1,3 -3z" />
    <!-- condition icon: a cloud -->
    <path android:fillColor="#FFECEFF2" android:pathData="M74,52h14a4,4 0,0 0,0 -8a5.5,5.5 0,0 0,-10.5 -1.5a4.8,4.8 0,0 0,-3.5 9.5z" />
    <!-- condition -->
    <path android:fillColor="#E6FFFFFF" android:pathData="M29,61h30a1.8,1.8 0,0 1,0 3.6h-30a1.8,1.8 0,0 1,0 -3.6z" />
    <!-- high / low, gold -->
    <path android:fillColor="#FFFFC93C" android:pathData="M29,69h26a1.5,1.5 0,0 1,0 3h-26a1.5,1.5 0,0 1,0 -3z" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Themes and component styles. Every value comes from tokens.xml. -->
<resources>
    <!-- Home screen: transparent over the wallpaper, edge to edge. -->
    <style name="Theme.Searchlight" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorHighlight">@color/accent_soft</item>
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:alertDialogTheme">@style/Theme.Searchlight.Dialog</item>
    </style>

    <!-- Settings, Widget Center, pickers: follow the system light/dark theme, with our accent. -->
    <!-- No framework action bar: each screen draws its own title inside the inset-padded
         content, so the header can never end up under the status bar (Android 15+). -->
    <style name="Theme.Searchlight.Settings" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:alertDialogTheme">@style/Theme.Searchlight.Dialog</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style name="PageTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Searchlight.TileTitle</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:paddingTop">@dimen/space_m</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <!-- Dialogs (pickers, brightness, greeting): Lexend + accent, light/dark per system. -->
    <style name="Theme.Searchlight.Dialog" parent="android:Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!-- A compact text button in the edit-mode pill: sizes to its label, never wraps. -->
    <!-- A single line of text in a one-row home tile: shrinks with "…" rather than wrapping. -->
    <style name="StripText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <!-- A hairline between the unfolded rail's groups. -->
    <style name="RailDivider">
        <item name="android:layout_width">@dimen/size_rail_divider</item>
        <item name="android:layout_height">@dimen/stroke_glass</item>
        <item name="android:layout_marginVertical">@dimen/space_s</item>
        <item name="android:background">@color/glass_border</item>
    </style>

    <!-- An edge you can drop a dragged app on (unfolded all-apps panel). -->
    <style name="DropZone">
        <item name="android:layout_width">@dimen/size_drop_zone</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@color/accent_soft</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="EditPillButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:paddingHorizontal">@dimen/space_m</item>
        <item name="android:textAppearance">@style/TextAppearance.Searchlight.Body</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="OnWallpaperText">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:shadowColor">@color/scrim</item>
        <item name="android:shadowRadius">6</item>
        <item name="android:shadowDy">1</item>
    </style>

    <style name="SettingsSection">
        <item name="android:textAppearance">@style/TextAppearance.Searchlight.Caption</item>
        <item name="android:textColor">?android:attr/colorAccent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">@dimen/space_l</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:minHeight">@dimen/size_row</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingVertical">@dimen/space_s</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="SettingsRowTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Searchlight.Body</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="SettingsRowSummary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.Searchlight.Caption</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
</resources>

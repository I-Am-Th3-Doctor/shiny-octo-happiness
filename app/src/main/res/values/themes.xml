<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="toy_purple">#FF8A2BFF</color>
    <color name="toy_sky">#FF00A8FF</color>

    <style name="Theme.ChildsPlay" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/toy_purple</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <style name="Theme.HeroWeather" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/toy_sky</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Searchlight design tokens: the only place sizes, radii, type and colors are defined.
  Layouts, drawables, styles and Kotlin all reference these; nothing else hardcodes a value.
  (Vector icon artwork - the 24dp viewport paths in res/drawable/ic_*.xml - is asset data,
  not styling, and is out of scope.)
-->
<resources>

    <!-- ===== Spacing scale: 4 / 8 / 16 / 24 ===================================== -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_s">8dp</dimen>
    <dimen name="space_m">16dp</dimen>
    <dimen name="space_l">24dp</dimen>

    <!-- ===== Corner radii ======================================================== -->
    <dimen name="radius_card">28dp</dimen>
    <!-- "50%": Android clamps a corner radius to half the shape's height, so any value at
         least that large gives a true pill / circle at every size. -->
    <dimen name="radius_pill">999dp</dimen>
    <dimen name="radius_home_card">30dp</dimen>     <!-- the home card (tiles + search row) -->
    <!-- The tile strip, inset by the card's space_s padding: 30 - 8, so its corners run parallel to the card's. -->
    <dimen name="radius_home_row">22dp</dimen>
    <dimen name="inset_home_card">12dp</dimen>      <!-- home card to the screen sides and bottom -->
    <dimen name="radius_tile">20dp</dimen>

    <!-- ===== Type scale ========================================================== -->
    <dimen name="text_glance">46sp</dimen>      <!-- big temp / time / battery % -->
    <dimen name="text_tile_title">18sp</dimen>  <!-- a tile's main line, the search field -->
    <dimen name="text_body">13sp</dimen>
    <dimen name="text_caption">10sp</dimen>

    <!-- ===== Component sizes (fixed parts, not spacing) ========================== -->
    <dimen name="size_touch">48dp</dimen>             <!-- minimum touch target -->
    <dimen name="size_touch_wide">56dp</dimen>        <!-- primary control (play/pause) -->
    <dimen name="size_icon">24dp</dimen>
    <dimen name="size_avatar">40dp</dimen>            <!-- result icons, contact photos -->
    <dimen name="size_row">56dp</dimen>
    <dimen name="size_search_row">60dp</dimen>        <!-- the search pill in the home card -->               <!-- list row / search row height -->
    <dimen name="size_row_tall">96dp</dimen>          <!-- widget-picker row -->
    <dimen name="size_quick_action">56dp</dimen>      <!-- Quick Actions circle -->
    <dimen name="size_badge">24dp</dimen>             <!-- edit-mode remove / resize badges -->
    <dimen name="size_dot">6dp</dimen>                <!-- page dots, inside the tile row -->
    <dimen name="size_progress">4dp</dimen>           <!-- day-of-year bar -->
    <dimen name="size_tile_height">@dimen/size_row</dimen>  <!-- the tile pager: one row, like the search row -->
    <dimen name="size_grid_icon">56dp</dimen>         <!-- favorites grid icon -->
    <dimen name="size_result_icon">48dp</dimen>       <!-- search results app icon -->
    <dimen name="marquee_speed">32dp</dimen>           <!-- tile text scroll, per second -->
    <dimen name="size_calc_preview_max">160dp</dimen>   <!-- answer in the search row -->
    <dimen name="size_edit_bar">40dp</dimen>            <!-- edit-mode pill -->
    <!-- Space kept above the widget grid so the edit pill never covers a cell:
         space_s + size_edit_bar + space_s. -->
    <dimen name="size_edit_bar_reserve">56dp</dimen>
    <dimen name="size_swipe">64dp</dimen>              <!-- distance that counts as a swipe -->
    <dimen name="size_preview_width">120dp</dimen>    <!-- widget picker preview -->
    <dimen name="size_preview_height">88dp</dimen>
    <dimen name="stroke_hairline">1.5dp</dimen>
    <dimen name="stroke_glass">1dp</dimen>
    <dimen name="blur_radius">24dp</dimen>         <!-- backdrop blur behind glass surfaces -->
    <dimen name="stroke_dash">4dp</dimen>
    <dimen name="elevation_raised">8dp</dimen>
    <!-- On the unfolded inner screen content stays a comfortable column instead of stretching. -->
    <dimen name="content_max_width">600dp</dimen>

    <!-- ===== Color: one accent ==================================================== -->
    <!-- Rust. For fills and strokes (selection, "on" states, progress, drop targets). It's too
         dark for small text on the dark surfaces, so text stays on_surface. -->
    <color name="accent">#FF9C4A2F</color>
    <color name="accent_soft">#599C4A2F</color>     <!-- 35%: selected row, valid drop -->
    <color name="on_accent">#FFFFFFFF</color>

    <!-- ===== Color: neutral dark translucent surfaces (55–65% near-black) ======== -->
    <color name="surface_card">#9E0B0B0D</color>    <!-- 62%: results panel and web pill without a blur -->
    <color name="surface_raised">#A60B0B0D</color>  <!-- 65%: popups, edit bar, badges -->
    <!-- Home card glass: over the blurred wallpaper / without a blur (darker, for legibility). -->
    <color name="glass_card">#800B0B0D</color>      <!-- 50% -->
    <color name="glass_card_fallback">#BF0B0B0D</color> <!-- 75% -->
    <color name="glass_row">#590B0B0D</color>       <!-- 35%: the search row, lighter than the card -->
    <color name="glass_border">#26FFFFFF</color>    <!-- 15% white hairline round the glass -->
    <color name="surface_frost">#730B0B0D</color>   <!-- 45%: over the blurred wallpaper (results panel, web pill) -->
    <color name="surface_inset">#1FFFFFFF</color>   <!-- the search row inside the card -->
    <color name="control_off">#33FFFFFF</color>     <!-- off toggles, empty art, tracks -->

    <color name="on_surface">#FFFFFFFF</color>
    <color name="on_surface_dim">#B3FFFFFF</color>
    <color name="on_surface_faint">#59FFFFFF</color>
    <color name="outline">#6EFFFFFF</color>         <!-- edit-mode grid -->
    <color name="scrim">#99000000</color>           <!-- text shadow over wallpaper -->
    <color name="danger">#FFFF5252</color>
    <color name="danger_soft">#5AFF5252</color>     <!-- invalid drop -->

    <!-- ===== Color: content categories (result badges; meaning, not decoration) == -->
    <color name="cat_pdf">#FFE53935</color>
    <color name="cat_image">#FF43A047</color>
    <color name="cat_video">#FF8E24AA</color>
    <color name="cat_audio">#FFFB8C00</color>
    <color name="cat_archive">#FF6D4C41</color>
    <color name="cat_document">#FF1E88E5</color>
    <color name="cat_sheet">#FF2E7D32</color>
    <color name="cat_slides">#FFF4511E</color>
    <color name="cat_apk">#FF00897B</color>
    <color name="cat_other">#FF546E7A</color>
    <color name="cat_folder">#FFFFCA28</color>
    <color name="cat_message">#FF1E88E5</color>

    <!-- Contact initials when there's no photo. -->
    <color name="avatar_1">#FF5C6BC0</color>
    <color name="avatar_2">#FF26A69A</color>
    <color name="avatar_3">#FFEF5350</color>
    <color name="avatar_4">#FFAB47BC</color>
    <color name="avatar_5">#FF42A5F5</color>
    <color name="avatar_6">#FFFFA726</color>
    <color name="avatar_7">#FF66BB6A</color>
    <color name="avatar_8">#FF8D6E63</color>

    <!-- ===== Typeface ============================================================ -->
    <!-- Lexend everywhere (bundled in res/font). Set as the theme default in themes.xml, so
         every TextView, Button, Switch, EditText, dialog and popup menu picks it up. -->

    <!-- ===== Text appearances (the type scale as styles) ========================= -->
    <!-- parent="" on purpose: they set size and weight only, never color, so applying one
         from code can't reset a view's text color. -->
    <style name="TextAppearance.Searchlight.Glance" parent="">
        <item name="android:textSize">@dimen/text_glance</item>
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Semibold: weight 600 (Android 9+, below our minSdk 29). -->
    <style name="TextAppearance.Searchlight.TileTitle" parent="">
        <item name="android:textSize">@dimen/text_tile_title</item>
        <item name="android:fontFamily">@font/lexend</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <style name="TextAppearance.Searchlight.Body" parent="">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/lexend</item>
    </style>

    <style name="TextAppearance.Searchlight.Caption" parent="">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">@font/lexend</item>
    </style>
</resources>

    <string name="focus_dnd_ask_title">Do Not Disturb in Focus</string>
    <string name="focus_dnd_ask_message">Focus can turn on Do Not Disturb (with your own exceptions: starred contacts, repeat callers, alarms) and turn it back off when you leave. Android needs you to allow Do Not Disturb access for that.</string>

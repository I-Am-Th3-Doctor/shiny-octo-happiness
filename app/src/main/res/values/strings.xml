    <string name="settings_focus">Focus mode</string>
    <string name="settings_focus_help">Home shows only search, your allowed favorites and the Focus button: no tiles, no widgets, and Do Not Disturb on. Leave it with the same Focus button (in Quick Actions), a two-finger tap on home, or here: everything comes back as it was.</string>
    <string name="lock_ask_title">Double-tap to lock</string>
    <string name="lock_ask_message">Double-tapping empty space on the home screen can lock your phone. Android only lets an app lock the screen through its accessibility service: turn on Searchlight\'s to use it.</string>

<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the device tests post a test notification as Searchlight (to see
     its unread badge come and go). The release app never posts notifications. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
